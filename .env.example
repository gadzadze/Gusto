# Copy to .env.local for `next dev`, and to .env for scripts (drizzle-kit, admin:grant).
# Placeholders only. Never commit real values.

# Public URL of this app, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Settings → API). The anon/publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key

# Server only. Used for storage uploads and auth admin calls. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# App connection: Supavisor transaction pooler (port 6543) in production.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Migrations and scripts: direct or session-mode connection.
DATABASE_URL_DIRECT=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Email (Resend). Without RESEND_API_KEY nothing is sent: emails are logged as
# [DEV EMAIL] and the outbox marks them "skipped".
RESEND_API_KEY=
EMAIL_FROM="Gusto <orders@example.com>"

# Protects /api/cron/notifications. Must equal the Vault secret `gusto_cron_secret`
# (README, "Notifications and email"). Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string

# Integration tests only: a disposable database they may wipe. Never production.
DATABASE_URL_TEST=postgresql://postgres:postgres@127.0.0.1:5432/gusto_test

# `npm run db:seed` only runs against a local database. To allow a dedicated
# DEV Supabase project, list its database host here (comma-separated). Never a
# production host.
SEED_ALLOWED_HOSTS=
