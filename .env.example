# Copy to .env.local for `next dev`, and to .env for scripts (drizzle-kit, admin:grant).
# Placeholders only. Never commit real values.

# Public URL of this app, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Settings → API). The anon/publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key

# Server only. Used for storage uploads and auth admin calls. Never expose it.
# Use the JWT-style service_role key (starts with "eyJ"), NOT the newer "sb_secret_"
# key: the Auth admin API refuses the latter. Local: `npx supabase status -o env`
# prints SERVICE_ROLE_KEY and ANON_KEY (use that ANON_KEY below too).
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# App connection: Supavisor transaction pooler (port 6543) in production.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Migrations and scripts: direct or session-mode connection.
DATABASE_URL_DIRECT=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Email (Resend). Without RESEND_API_KEY nothing is sent: emails are logged as
# [DEV EMAIL] and the outbox marks them "skipped".
RESEND_API_KEY=
EMAIL_FROM="Gusto <orders@example.com>"

# Protects /api/cron/notifications. Must equal the Vault secret `gusto_cron_secret`
# (README, "Notifications and email"). Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string

# Optional: search the web for product photos (supplier picks, photo stays private to them).
# Google Programmable Search Engine with image search on: API key + engine id.
# Without both, the web option is hidden.
IMAGE_SEARCH_API_KEY=
IMAGE_SEARCH_ENGINE_ID=

# Integration tests only: a disposable database they may wipe. Never production.
DATABASE_URL_TEST=postgresql://postgres:postgres@127.0.0.1:5432/gusto_test

# `npm run db:seed` only runs against a local database. To allow a dedicated
# DEV Supabase project, list its database host here (comma-separated). Never a
# production host.
SEED_ALLOWED_HOSTS=

# Terms and Privacy pages print these as the operator behind Gusto. Read at BUILD
# time, like NEXT_PUBLIC_* values: change one in Vercel, then redeploy. The block
# is left out until LEGAL_ENTITY_NAME is set; set all four before real partners
# sign in. Only the legal entity's own details, never personal ones.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ID=
LEGAL_ADDRESS=
LEGAL_CONTACT_EMAIL=

# Sentry (error monitoring, errors only). Without NEXT_PUBLIC_SENTRY_DSN nothing
# is initialized and nothing is sent. The DSN is public by design and is inlined
# at BUILD time (redeploy after changing it). The three below are build-time only,
# for uploading source maps: SENTRY_AUTH_TOKEN is a secret, never NEXT_PUBLIC_.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
